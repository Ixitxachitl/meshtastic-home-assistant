#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Set the path to custom_components
## This let's us have the structure we want <root>/custom_components/homeassistant-meshtastic
## while at the same time have Home Assistant configuration inside <root>/config
## without resulting to symlinks.
export PYTHONPATH="${PYTHONPATH}:${PWD}/custom_components"

# Prefer the workspace venv so we do not pick up a mismatched global install.
if [[ -x "${PWD}/.venv/bin/hass" ]]; then
    HASS_BIN="${PWD}/.venv/bin/hass"
else
    HASS_BIN="hass"
fi

# Start Home Assistant.
#
# --debug turns on asyncio debug mode and floods the log with a formatted copy
# of every packet, which is enough to stall the event loop while a node
# database is streaming. Opt in with HASS_DEBUG=1 when you actually need it.
if [[ -n "${HASS_DEBUG:-}" ]]; then
    "${HASS_BIN}" --config "${PWD}/config" --debug
else
    "${HASS_BIN}" --config "${PWD}/config"
fi
